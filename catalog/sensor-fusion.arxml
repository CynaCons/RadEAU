<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUTOSAR Ethernet Communication Extract - sensor-fusion network
  (SRS_protocols.md section 4; SRS_ecu_netsim.md section 6).

  The reference definition of the simulated network: SOME/IP service
  interfaces, their event payload layouts (byte-aligned base types with
  linear scaling), deployments (service/event ids), and provided instances
  (sockets). ecu-netsim encodes payloads from these layouts and the app
  decodes with them - one shared definition.

  Subset discipline: correct AUTOSAR R4 containers and references, restricted
  to what the network needs. Payload records are byte-aligned, big-endian
  (SOME/IP default), fields in declaration order at sequential offsets.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>BaseTypes</SHORT-NAME>
      <ELEMENTS>
        <SW-BASE-TYPE><SHORT-NAME>uint8</SHORT-NAME><BASE-TYPE-SIZE>8</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING></SW-BASE-TYPE>
        <SW-BASE-TYPE><SHORT-NAME>uint16</SHORT-NAME><BASE-TYPE-SIZE>16</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING></SW-BASE-TYPE>
        <SW-BASE-TYPE><SHORT-NAME>uint32</SHORT-NAME><BASE-TYPE-SIZE>32</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING></SW-BASE-TYPE>
        <SW-BASE-TYPE><SHORT-NAME>sint16</SHORT-NAME><BASE-TYPE-SIZE>16</BASE-TYPE-SIZE><BASE-TYPE-ENCODING>2C</BASE-TYPE-ENCODING></SW-BASE-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Units</SHORT-NAME>
      <ELEMENTS>
        <UNIT><SHORT-NAME>m</SHORT-NAME><DISPLAY-NAME>m</DISPLAY-NAME></UNIT>
        <UNIT><SHORT-NAME>mps</SHORT-NAME><DISPLAY-NAME>m/s</DISPLAY-NAME></UNIT>
        <UNIT><SHORT-NAME>radps</SHORT-NAME><DISPLAY-NAME>rad/s</DISPLAY-NAME></UNIT>
        <UNIT><SHORT-NAME>mps2</SHORT-NAME><DISPLAY-NAME>m/s^2</DISPLAY-NAME></UNIT>
        <UNIT><SHORT-NAME>ms</SHORT-NAME><DISPLAY-NAME>ms</DISPLAY-NAME></UNIT>
        <UNIT><SHORT-NAME>percent</SHORT-NAME><DISPLAY-NAME>%</DISPLAY-NAME></UNIT>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>CompuMethods</SHORT-NAME>
      <ELEMENTS>
        <COMPU-METHOD><SHORT-NAME>Identity</SHORT-NAME><CATEGORY>IDENTICAL</CATEGORY></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Centi_m</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/m</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>100</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Centi_mps</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/mps</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>100</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Milli_radps</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/radps</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>1000</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Milli_mps2</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/mps2</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>1000</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Deci_ms</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/ms</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>10</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Centi_ms</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/ms</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>100</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
        <COMPU-METHOD><SHORT-NAME>Percent</SHORT-NAME><CATEGORY>LINEAR</CATEGORY><UNIT-REF DEST="UNIT">/Units/percent</UNIT-REF><COMPU-INTERNAL-TO-PHYS><COMPU-SCALES><COMPU-SCALE><COMPU-RATIONAL-COEFFS><COMPU-NUMERATOR><V>0</V><V>1</V></COMPU-NUMERATOR><COMPU-DENOMINATOR><V>1</V></COMPU-DENOMINATOR></COMPU-RATIONAL-COEFFS></COMPU-SCALE></COMPU-SCALES></COMPU-INTERNAL-TO-PHYS></COMPU-METHOD>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>DataTypes</SHORT-NAME>
      <ELEMENTS>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>ObjectList_T</SHORT-NAME>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>ObjectCount</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>FrameCounter</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>ExposureTime</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Centi_ms</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>TargetList_T</SHORT-NAME>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>TargetCount</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>NearestRange</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Centi_m</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>NearestSpeed</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/sint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Centi_mps</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>ClusterList_T</SHORT-NAME>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>ClusterCount</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>PointCount</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint32</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>MeanIntensity</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Percent</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>DynamicsState_T</SHORT-NAME>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>VehicleSpeed</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Centi_mps</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>YawRate</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/sint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Milli_radps</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>AccelX</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/sint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Milli_mps2</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>FusedTrackList_T</SHORT-NAME>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>TrackCount</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>QualityMean</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Percent</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>LeadRange</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Centi_m</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>LeadSpeed</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/sint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Centi_mps</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>FusionStats_T</SHORT-NAME>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>InputLatencyCam</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Deci_ms</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>MatchedTracks</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT><SHORT-NAME>UnmatchedTracks</SHORT-NAME><BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF><COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Identity</COMPU-METHOD-REF></IMPLEMENTATION-DATA-TYPE-ELEMENT>
          </SUB-ELEMENTS>
        </IMPLEMENTATION-DATA-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>ServiceInterfaces</SHORT-NAME>
      <ELEMENTS>
        <SERVICE-INTERFACE>
          <SHORT-NAME>CameraObjects</SHORT-NAME>
          <EVENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>ObjectList</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/ObjectList_T</TYPE-TREF></VARIABLE-DATA-PROTOTYPE></EVENTS>
        </SERVICE-INTERFACE>
        <SERVICE-INTERFACE>
          <SHORT-NAME>RadarTargets</SHORT-NAME>
          <EVENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>TargetList</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/TargetList_T</TYPE-TREF></VARIABLE-DATA-PROTOTYPE></EVENTS>
        </SERVICE-INTERFACE>
        <SERVICE-INTERFACE>
          <SHORT-NAME>LidarClusters</SHORT-NAME>
          <EVENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>ClusterList</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/ClusterList_T</TYPE-TREF></VARIABLE-DATA-PROTOTYPE></EVENTS>
        </SERVICE-INTERFACE>
        <SERVICE-INTERFACE>
          <SHORT-NAME>VehicleDynamics</SHORT-NAME>
          <EVENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>DynamicsState</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/DynamicsState_T</TYPE-TREF></VARIABLE-DATA-PROTOTYPE></EVENTS>
        </SERVICE-INTERFACE>
        <SERVICE-INTERFACE>
          <SHORT-NAME>FusedObjects</SHORT-NAME>
          <EVENTS>
            <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>FusedTrackList</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/FusedTrackList_T</TYPE-TREF></VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>FusionStats</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/FusionStats_T</TYPE-TREF></VARIABLE-DATA-PROTOTYPE>
          </EVENTS>
          <METHODS><CLIENT-SERVER-OPERATION><SHORT-NAME>SetFusionMode</SHORT-NAME></CLIENT-SERVER-OPERATION></METHODS>
        </SERVICE-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Deployments</SHORT-NAME>
      <ELEMENTS>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          <SHORT-NAME>CameraObjects_Deploy</SHORT-NAME>
          <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ServiceInterfaces/CameraObjects</SERVICE-INTERFACE-REF>
          <SERVICE-INTERFACE-ID>4353</SERVICE-INTERFACE-ID>
          <EVENT-DEPLOYMENTS><SOMEIP-EVENT-DEPLOYMENT><SHORT-NAME>ObjectList</SHORT-NAME><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ServiceInterfaces/CameraObjects/ObjectList</EVENT-REF><EVENT-ID>32769</EVENT-ID></SOMEIP-EVENT-DEPLOYMENT></EVENT-DEPLOYMENTS>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          <SHORT-NAME>RadarTargets_Deploy</SHORT-NAME>
          <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ServiceInterfaces/RadarTargets</SERVICE-INTERFACE-REF>
          <SERVICE-INTERFACE-ID>4354</SERVICE-INTERFACE-ID>
          <EVENT-DEPLOYMENTS><SOMEIP-EVENT-DEPLOYMENT><SHORT-NAME>TargetList</SHORT-NAME><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ServiceInterfaces/RadarTargets/TargetList</EVENT-REF><EVENT-ID>32769</EVENT-ID></SOMEIP-EVENT-DEPLOYMENT></EVENT-DEPLOYMENTS>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          <SHORT-NAME>LidarClusters_Deploy</SHORT-NAME>
          <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ServiceInterfaces/LidarClusters</SERVICE-INTERFACE-REF>
          <SERVICE-INTERFACE-ID>4355</SERVICE-INTERFACE-ID>
          <EVENT-DEPLOYMENTS><SOMEIP-EVENT-DEPLOYMENT><SHORT-NAME>ClusterList</SHORT-NAME><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ServiceInterfaces/LidarClusters/ClusterList</EVENT-REF><EVENT-ID>32769</EVENT-ID></SOMEIP-EVENT-DEPLOYMENT></EVENT-DEPLOYMENTS>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          <SHORT-NAME>VehicleDynamics_Deploy</SHORT-NAME>
          <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ServiceInterfaces/VehicleDynamics</SERVICE-INTERFACE-REF>
          <SERVICE-INTERFACE-ID>4356</SERVICE-INTERFACE-ID>
          <EVENT-DEPLOYMENTS><SOMEIP-EVENT-DEPLOYMENT><SHORT-NAME>DynamicsState</SHORT-NAME><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ServiceInterfaces/VehicleDynamics/DynamicsState</EVENT-REF><EVENT-ID>32769</EVENT-ID></SOMEIP-EVENT-DEPLOYMENT></EVENT-DEPLOYMENTS>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
        <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          <SHORT-NAME>FusedObjects_Deploy</SHORT-NAME>
          <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ServiceInterfaces/FusedObjects</SERVICE-INTERFACE-REF>
          <SERVICE-INTERFACE-ID>4609</SERVICE-INTERFACE-ID>
          <EVENT-DEPLOYMENTS>
            <SOMEIP-EVENT-DEPLOYMENT><SHORT-NAME>FusedTrackList</SHORT-NAME><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ServiceInterfaces/FusedObjects/FusedTrackList</EVENT-REF><EVENT-ID>32769</EVENT-ID></SOMEIP-EVENT-DEPLOYMENT>
            <SOMEIP-EVENT-DEPLOYMENT><SHORT-NAME>FusionStats</SHORT-NAME><EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ServiceInterfaces/FusedObjects/FusionStats</EVENT-REF><EVENT-ID>32770</EVENT-ID></SOMEIP-EVENT-DEPLOYMENT>
          </EVENT-DEPLOYMENTS>
          <METHOD-DEPLOYMENTS><SOMEIP-METHOD-DEPLOYMENT><SHORT-NAME>SetFusionMode</SHORT-NAME><METHOD-REF DEST="CLIENT-SERVER-OPERATION">/ServiceInterfaces/FusedObjects/SetFusionMode</METHOD-REF><METHOD-ID>1</METHOD-ID></SOMEIP-METHOD-DEPLOYMENT></METHOD-DEPLOYMENTS>
        </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Instances</SHORT-NAME>
      <ELEMENTS>
        <PROVIDED-SOMEIP-SERVICE-INSTANCE><SHORT-NAME>CameraObjects_1</SHORT-NAME><SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/Deployments/CameraObjects_Deploy</SERVICE-INTERFACE-DEPLOYMENT-REF><SERVICE-INSTANCE-ID>1</SERVICE-INSTANCE-ID><IPV4-ADDRESS>10.42.0.11</IPV4-ADDRESS><UDP-PORT>30490</UDP-PORT></PROVIDED-SOMEIP-SERVICE-INSTANCE>
        <PROVIDED-SOMEIP-SERVICE-INSTANCE><SHORT-NAME>RadarTargets_1</SHORT-NAME><SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/Deployments/RadarTargets_Deploy</SERVICE-INTERFACE-DEPLOYMENT-REF><SERVICE-INSTANCE-ID>1</SERVICE-INSTANCE-ID><IPV4-ADDRESS>10.42.0.12</IPV4-ADDRESS><UDP-PORT>30490</UDP-PORT></PROVIDED-SOMEIP-SERVICE-INSTANCE>
        <PROVIDED-SOMEIP-SERVICE-INSTANCE><SHORT-NAME>LidarClusters_1</SHORT-NAME><SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/Deployments/LidarClusters_Deploy</SERVICE-INTERFACE-DEPLOYMENT-REF><SERVICE-INSTANCE-ID>1</SERVICE-INSTANCE-ID><IPV4-ADDRESS>10.42.0.13</IPV4-ADDRESS><UDP-PORT>30490</UDP-PORT></PROVIDED-SOMEIP-SERVICE-INSTANCE>
        <PROVIDED-SOMEIP-SERVICE-INSTANCE><SHORT-NAME>VehicleDynamics_1</SHORT-NAME><SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/Deployments/VehicleDynamics_Deploy</SERVICE-INTERFACE-DEPLOYMENT-REF><SERVICE-INSTANCE-ID>1</SERVICE-INSTANCE-ID><IPV4-ADDRESS>10.42.0.14</IPV4-ADDRESS><UDP-PORT>30490</UDP-PORT></PROVIDED-SOMEIP-SERVICE-INSTANCE>
        <PROVIDED-SOMEIP-SERVICE-INSTANCE><SHORT-NAME>FusedObjects_1</SHORT-NAME><SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">/Deployments/FusedObjects_Deploy</SERVICE-INTERFACE-DEPLOYMENT-REF><SERVICE-INSTANCE-ID>1</SERVICE-INSTANCE-ID><IPV4-ADDRESS>10.42.0.20</IPV4-ADDRESS><UDP-PORT>30490</UDP-PORT></PROVIDED-SOMEIP-SERVICE-INSTANCE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
